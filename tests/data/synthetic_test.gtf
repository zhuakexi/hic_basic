# Synthetic GTF file for testing gene track visualization
# This file contains a simulated gene model with multiple transcripts, exons, CDS, and UTRs

chr1	synthetic	gene	1000	9000	.	+	.	gene_id "GENE001"; gene_name "TEST1"; gene_biotype "protein_coding";
chr1	synthetic	transcript	1000	9000	.	+	.	gene_id "GENE001"; transcript_id "TXN001"; transcript_name "TEST1-001"; transcript_biotype "protein_coding";
